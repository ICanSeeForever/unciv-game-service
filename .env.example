# Unciv MultiplayerFiles path on the host (mounted into container)
CIV_PATH=/path/to/unciv/data


# Launcher type: "ssh" or "local"
LAUNCHER_TYPE=ssh

# --- SSH launcher settings (required when LAUNCHER_TYPE=ssh) ---
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
SSH_UNCIV_JAR_PATH=~/Unciv.jar

# --- Local launcher settings (required when LAUNCHER_TYPE=local) ---
# UNCIV_JAR_PATH=/opt/unciv/Unciv.jar

# --- Map check thresholds (optional, defaults shown) ---
# EXPECT_MIN_DISTANCE=10
# EXPECT_MAX_DISTANCE=16
# EXPECT_MIN_LUXURIES=5
# EXPECT_MIN_UNIQUE_LUXURIES=1
# EXPECT_MIN_LAND_PER_PLAYER=185
# EXPECT_MAX_LAND_PER_PLAYER=200
# MAX_START_ATTEMPTS=30
