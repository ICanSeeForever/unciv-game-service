# Unciv MultiplayerFiles path on the host (mounted into container at /data/unciv)
CIV_PATH=/path/to/unciv/data

# Launcher type: "local" (default) or "ssh"
LAUNCHER_TYPE=local

# --- Local launcher settings ---
# Path to Unciv.jar inside the container (mounted via docker-compose.yml volume)
UNCIV_JAR_PATH=/opt/unciv/Unciv.jar

# --- SSH launcher settings (required when LAUNCHER_TYPE=ssh) ---
# SSH_HOST=
# SSH_USER=
# SSH_KEY_PATH=           # path to private key file (leave empty to use password)
# SSH_PASSWORD=           # password auth (used if SSH_KEY_PATH is not set)
# SSH_SUDO_PASSWORD=      # sudo -S password on the remote host (if needed)
# SSH_UNCIV_JAR_PATH=/var/civ_game/Unciv.jar
# SSH_UNCIV_WORK_DIR=/var/civ_game

# --- Map check thresholds (optional, defaults shown) ---
# EXPECT_MIN_DISTANCE=10
# EXPECT_MAX_DISTANCE=16
# EXPECT_MIN_LUXURIES=5
# EXPECT_MIN_UNIQUE_LUXURIES=1
# EXPECT_MIN_LAND_PER_PLAYER=185
# EXPECT_MAX_LAND_PER_PLAYER=200
# MAX_START_ATTEMPTS=30
